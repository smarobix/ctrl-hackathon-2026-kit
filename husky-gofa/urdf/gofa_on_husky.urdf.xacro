<?xml version="1.0"?>
<!-- The ABB GoFa CRB 15000-12/1.27 on the Husky's top plate. robot.yaml adds this file as a URDF extra. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="/opt/kit/urdf/abb_gofa_12_127.xacro"/>
  <xacro:abb_gofa_12_127 prefix="arm_0_" parent_link="top_plate_default_mount">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:abb_gofa_12_127>
</robot>
